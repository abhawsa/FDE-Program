# Copy this file to .env and fill in real values. Never commit the real .env file.
# All values below are OPTIONAL - the agent runs end-to-end without any of them,
# using safe local fallbacks (template test drafts, no-op tracing).

# --- LLM (test draft generation) ---
# Required only to have Claude draft real test bodies instead of TODO stub templates.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- LangFuse (observability / tracing) ---
# Required only to see generation + review traces in LangFuse. Sign up free at
# https://cloud.langfuse.com or self-host.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Risk ranking tuning ---
RISK_LOOKBACK_DAYS=180
RISK_TOP_N=10
